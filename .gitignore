# ==============================
# Java / Spring Boot .gitignore
# ==============================

# Build-Output
/target/
!/target/.gitkeep

# pictures/upload
/uploads/

# --- BRUNO API CLIENT ---
# Wir ignorieren lokale Umgebungs-Einstellungen (Secrets/Passwörter)
# Die Requests selbst (.bru Dateien in anderen Ordnern) werden hochgeladen
api-requests/environments/*.bru
# Falls Bruno Backup-Dateien erstellt
api-requests/**/*.bak
api-requests/**/*.tmp

# IDEs & Tools
### IntelliJ IDEA ###
.idea/
*.iml
out/
.idea_modules/

### Eclipse ###
.project
.classpath
.settings/
bin/

### VS Code ###
.vscode/
.history/
*.code-workspace

# Logs
logs/
*.log

# OS-spezifisch
### macOS ###
.DS_Store

### Windows ###
Thumbs.db
Desktop.ini

# Java & Maven
*.class
*.jar
*.war
*.ear

# Maven-specific
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Environment / Secrets
.env
*.env
application-*.yml
application-*.properties
!application-example.yml
!application-example.properties

# Test reports / coverage
surefire-reports/
failsafe-reports/
jacoco.exec
